{
  "rules": {
    ".read": false,
    ".write": false,
    "room": {
      ".read": "auth != null",

      "state": {
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['round', 'revealed']) && newData.child('round').isNumber() && newData.child('revealed').isBoolean() && ((newData.child('revealed').val() === true && ((data.exists() && newData.child('round').val() === data.child('round').val()) || (!data.exists() && newData.child('round').val() === 0))) || (newData.child('revealed').val() === false && !newData.parent().child('votes').exists() && ((data.exists() && newData.child('round').val() === data.child('round').val() + 1) || (!data.exists() && newData.child('round').val() === 1))))",
        "round": { ".validate": true },
        "revealed": { ".validate": true },
        "$other": { ".validate": false }
      },

      "votes": {
        ".write": "auth != null && !newData.exists() && ((data.parent().child('state').exists() && newData.parent().child('state/round').val() === data.parent().child('state/round').val() + 1) || (!data.parent().child('state').exists() && newData.parent().child('state/round').val() === 1))",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('room/state/revealed').val() !== true",
          ".validate": "newData.hasChildren(['value', 'round']) && ((root.child('room/state').exists() && newData.child('round').val() === root.child('room/state/round').val()) || (!root.child('room/state').exists() && newData.child('round').val() === 0))",
          "value": { ".validate": "newData.isString() && newData.val().matches(/^(\\?|0|1|2|3|5|8|scissors)$/)" },
          "round": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },

      "participants": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && (!data.child('lastActive').exists() || data.child('lastActive').val() < now - 1200000)))",
          "lastActive": { ".validate": "newData.isNumber() && newData.val() === now" },
          "observer": { ".validate": "newData.isBoolean()" },
          "pseudo": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "connections": {
            "$connId": { ".validate": "newData.val() === true" }
          },
          "$other": { ".validate": false }
        }
      },

      "settings": {
        "autoReveal": { ".write": "auth != null", ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      },

      "pseudos": {
        "$key": {
          ".write": "auth != null && ((newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid || !root.child('room/participants').child(data.val()).child('connections').exists())) || (!newData.exists() && data.val() === auth.uid))",
          ".validate": "newData.isString() && $key.length <= 200"
        }
      }
    }
  }
}
